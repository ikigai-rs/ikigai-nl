@prefix nl:   <https://ikigai-rs.dev/ns/nl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

# The few terms `urn:nl:grounding` and a drafter's provenance need that no shared vocabulary
# has. Everything else the grounding says is said with ik: (the actions), rdfs: (the
# vocabulary), VoID (each graph's shape), schema: (the worked examples), dcterms: and prov:
# (identity and origin); a draft's provenance is PROV-O (prov:Activity, prov:Entity,
# prov:value, prov:wasRevisionOf, prov:wasAttributedTo) with the five terms at the end.
# Bundled into ikigai-nl as `ikigai_nl::VOCABULARY`; a test holds the renderer to it, so
# a term the renderer emits and this file does not define fails the build.

<https://ikigai-rs.dev/ns/nl> a owl:Ontology ;
    rdfs:label "ikigai natural-language vocabulary" ;
    rdfs:comment "Terms for the grounding a natural-language drafter is given, and for the provenance of what it drafts." ;
    owl:versionInfo "0.1.0" .

nl:Grounding a rdfs:Class ;
    rdfs:label "Grounding" ;
    rdfs:comment "What a drafter may know, as data, under one caller's capability: the actions it may take, the vocabulary, the shape of each graph it may read, and worked examples. Named by the sha256 of its content, so a draft can cite the exact grounding it saw." .

nl:Part a rdfs:Class ;
    rdfs:label "Part" ;
    rdfs:comment "One part of a grounding, derived from one resource (prov:wasDerivedFrom) and named by the sha256 of what it holds (dcterms:identifier)." .

nl:focus a rdf:Property ;
    rdfs:label "focus" ;
    rdfs:comment "The graph IRI or topic word the grounding was narrowed to." ;
    rdfs:domain nl:Grounding ;
    rdfs:range xsd:string .

nl:shown a rdf:Property ;
    rdfs:label "shown" ;
    rdfs:comment "How many items this part holds. Fewer than nl:of means the part was narrowed by a focus or bounded: first N of M, never a silent truncation." ;
    rdfs:domain nl:Part ;
    rdfs:range xsd:integer .

nl:of a rdf:Property ;
    rdfs:label "of" ;
    rdfs:comment "How many items the source offered this caller before focus and bounds." ;
    rdfs:domain nl:Part ;
    rdfs:range xsd:integer .

nl:sample a rdf:Property ;
    rdfs:label "sample" ;
    rdfs:comment "One triple from the graph, as an N-Triples line. A literal, so a blank node in the data stays a label inside a string and never becomes a node of the grounding." ;
    rdfs:range xsd:string .

nl:samplesShown a rdf:Property ;
    rdfs:label "samples shown" ;
    rdfs:comment "How many nl:sample lines are given, against void:triples in all." ;
    rdfs:range xsd:integer .

nl:classesShown a rdf:Property ;
    rdfs:label "classes shown" ;
    rdfs:comment "How many void:classPartition nodes are given, against void:classes in all." ;
    rdfs:range xsd:integer .

nl:propertiesShown a rdf:Property ;
    rdfs:label "properties shown" ;
    rdfs:comment "How many void:propertyPartition nodes are given, against void:properties in all." ;
    rdfs:range xsd:integer .

nl:ask a rdf:Property ;
    rdfs:label "ask" ;
    rdfs:comment "What a person asked a drafter for, in natural language: the input of a drafting (a prov:Activity)." ;
    rdfs:range xsd:string .

nl:model a rdf:Property ;
    rdfs:label "model" ;
    rdfs:comment "The model that produced one attempt, as the LLM door that answered named it. The door itself is the attempt's prov:wasAttributedTo." ;
    rdfs:range xsd:string .

nl:valid a rdf:Property ;
    rdfs:label "valid" ;
    rdfs:comment "Whether one attempt passed every mechanical check (and, when it was saved, the script host kept it)." ;
    rdfs:range xsd:boolean .

nl:error a rdf:Property ;
    rdfs:label "error" ;
    rdfs:comment "One thing a check found wrong with an attempt, as the repair loop showed it to the model." ;
    rdfs:range xsd:string .

nl:warning a rdf:Property ;
    rdfs:label "warning" ;
    rdfs:comment "One thing a check could not decide about an attempt (an IRI past the grounding's bound, a parameter the preview left unbound)." ;
    rdfs:range xsd:string .
